# Runtime mode: development | production
ENVIRONMENT=development

# API metadata
API_TITLE=MathCoach API
API_VERSION=0.1.0
DEBUG=true

# Security
# Production requirements:
# - set ENVIRONMENT=production
# - set DEBUG=false
# - set SECRET_KEY to a random value with at least 32 characters
SECRET_KEY=change-me-in-production
TOKEN_EXPIRE_MINUTES=10080

# Database
# Leave empty to use sqlite fallback at services/api/mathcoach.db
DATABASE_URL=

# Comma-separated allowed CORS origins
CORS_ORIGINS_RAW=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Optional integrations
OPENAI_API_KEY=
